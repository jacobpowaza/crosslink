# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
*.tsbuildinfo
coverage/
target/
.build/
.gradle/
# Guard against a bare `tsc` emitting beside sdk-node sources. Those files
# shadow the `.ts` modules in Vitest because local imports use `.js` specifiers.
packages/sdk-node/src/*.js
packages/sdk-node/src/*.d.ts
!packages/sdk-node/src/bonjour-service.d.ts

# ── Crosslink runtime data (identity seeds, device records, tokens) ──
.crosslink-data/

# ── Generated browser bundles (rebuilt by each app's `bundle` script) ──
apps/*/public/bundle.js
examples/*/public/main.js

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# ── Demos / output (lives in separate repos) ──────────────────
brag-output/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Secrets (never commit these) ─────────────────────────────
*.pem
*.key
*.cert
*.p12
.env
.env.*
