{
  "name": "@crosslink/signaling",
  "version": "0.1.0",
  "description": "Crosslink signaling service: presence directory and pairing-code routing",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/jacobpowaza/crosslink.git", "directory": "services/signaling" },
  "homepage": "https://crosslink.mintlify.site",
  "bugs": { "url": "https://github.com/jacobpowaza/crosslink/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "crosslink-signaling": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@crosslink/dev-tokens": "^0.1.0",
    "@crosslink/protocol": "^0.1.0",
    "redis": "^5.12.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
