{
  "name": "crosslink-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Crosslink — universal secure app-to-app connectivity framework",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "adapters/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "stack": "concurrently -k -n signaling,relay \"node services/signaling/dist/cli.js\" \"node services/relay/dist/cli.js\"",
    "demo:echo": "node examples/echo-host/src/cli.ts",
    "demo:notes": "node examples/notes-host/src/cli.ts",
    "demo:pwa": "npm run serve -w @crosslink/demo-pwa",
    "demo:chat": "npm run dev -w @crosslink/demo-chat",
    "demo:todo-local": "node examples/todo-host/src/cli.ts --local",
    "demo:todo-relay": "node examples/todo-host/src/cli.ts",
    "demo:todo-client": "npm run dev -w @crosslink/example-todo-client",
    "demo:webrtc": "node examples/webrtc-upgrade/src/host.ts",
    "demo:webrtc-client": "npm run serve -w @crosslink/example-webrtc-upgrade",
    "tunnel": "node scripts/dev-tunnel.mjs",
    "demo:echo:tunnel": "node scripts/run-with-tunnel.mjs echo",
    "demo:notes:tunnel": "node scripts/run-with-tunnel.mjs notes",
    "demo:todo:tunnel": "node scripts/run-with-tunnel.mjs todo",
    "demo:chat:tunnel": "node scripts/run-with-tunnel.mjs chat",
    "demo:chat:cf": "CROSSLINK_TUNNEL=cloudflared npm run dev -w @crosslink/demo-chat",
    "demo:webrtc:tunnel": "node scripts/run-with-tunnel.mjs webrtc"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "untun": "^0.2.2"
  }
}
