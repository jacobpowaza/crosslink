{
  "name": "@crosslink/sdk-browser",
  "version": "0.1.1",
  "description": "Crosslink client SDK for browsers and PWAs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobpowaza/crosslink.git",
    "directory": "packages/sdk-browser"
  },
  "homepage": "https://crosslink.mintlify.site",
  "bugs": {
    "url": "https://github.com/jacobpowaza/crosslink/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crosslink.global.js": "./dist/crosslink.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --platform browser --external @crosslink/protocol --external @crosslink/core && npm run bundle",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --minify --format=iife --global-name=CrosslinkSDK --platform=browser --outfile=dist/crosslink.global.js"
  },
  "dependencies": {
    "@crosslink/core": "^0.1.0",
    "@crosslink/protocol": "^0.1.0",
    "@crosslink/webrtc-adapter": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3",
    "esbuild": "^0.28.2"
  }
}
