  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
