{
  "name": "@crosslink/sdk-node",
  "version": "0.1.0",
  "description": "Crosslink host SDK for Node.js: createCrosslinkServer, QR pairing, device management",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @crosslink/protocol --external @crosslink/core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crosslink/core": "*",
    "@crosslink/dev-tokens": "*",
    "@crosslink/protocol": "*",
    "@crosslink/webrtc-adapter": "*",
    "@noble/hashes": "^1.7.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
