{
  "name": "@crosslink/sdk",
  "version": "0.1.0",
  "description": "Crosslink umbrella SDK — server entry (Node) and browser entry (clients)",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/jacobpowaza/crosslink.git", "directory": "packages/sdk" },
  "homepage": "https://crosslink.mintlify.site",
  "bugs": { "url": "https://github.com/jacobpowaza/crosslink/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/node.ts src/browser.ts --format esm --dts --clean --external @crosslink/sdk-node --external @crosslink/sdk-browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crosslink/sdk-browser": "^0.1.0",
    "@crosslink/sdk-node": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
