{
  "name": "@crosslink/sdk",
  "version": "0.1.0",
  "description": "Crosslink umbrella SDK — server entry (Node) and browser entry (clients)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/node.ts src/browser.ts --format esm --dts --clean --external @crosslink/sdk-node --external @crosslink/sdk-browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crosslink/sdk-browser": "*",
    "@crosslink/sdk-node": "*"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
