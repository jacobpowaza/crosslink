{
  "name": "@crosslink/conformance",
  "version": "0.1.0",
  "description": "Language-neutral Crosslink protocol conformance runner",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/jacobpowaza/crosslink.git", "directory": "packages/conformance" },
  "homepage": "https://crosslink.mintlify.site",
  "bugs": { "url": "https://github.com/jacobpowaza/crosslink/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "fixtures"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crosslink/protocol": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3"
  }
}
