{
  "name": "@crosslink/react",
  "version": "0.1.0",
  "description": "React integration for Crosslink — framework-independent connectivity bindings",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "peerDependencies": {
    "react": ">=18.0.0",
    "@crosslink/sdk-browser": "*"
  },
  "dependencies": {
    "@crosslink/sdk-browser": "*"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3",
    "tsup": "^8.3.6"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external @crosslink/sdk-browser",
    "typecheck": "tsc --noEmit"
  }
}
